{
  "name": "@mcpbundles/mcp-connect-auth",
  "version": "0.1.0",
  "description": "MCP Connect Auth client library for Node.js",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkchainai/mcp-connect-auth-js"
  },
  "homepage": "https://www.mcpbundles.com/docs/integrations/mcp-connect-auth",
  "keywords": ["mcp", "oauth", "mcpbundles"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/public-config.test.ts src/federation.test.ts src/jwt-verifier.test.ts src/factory.test.ts src/middleware/connect-auth.test.ts"
  },
  "dependencies": {
    "jose": "^6.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0"
  }
}
